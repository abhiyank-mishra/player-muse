rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'mishraabhiyank0@gmail.com';
    }

    // ABSOLUTE ADMIN OVERRIDE - MUST BE FIRST
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /global_explorer/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && (
          // Standard update (no role/expiry/blocked changes)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'pro_expiry_date', 'pro_start_date', 'isBlocked']) ||
          // OR: Self-demotion from pro to normal when expired
          (resource.data.role == 'pro' && request.resource.data.role == 'normal' && resource.data.pro_expiry_date < request.time)
        ))
      );

      // Only admins can delete users
      allow delete: if isAdmin();

      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Curated Playlists - Admin managed playlists that appear in search
    // Read: any authenticated user (client filters isActive)
    // Write: admin only
    match /curatedPlaylists/{playlistId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Bug Reports - Users can report bugs, only admin can view
    match /bugReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Subscription Requests - Users can request, admin verifies
    match /subscriptionRequests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Notifications - Admin sends, users read their own
    match /notifications/{notificationId} {
      // Users can read only their own notifications
      allow read: if request.auth != null && request.auth.uid == resource.data.targetUserId;
      // Users can mark their own notifications as read (update only 'read' field)
      allow update: if request.auth != null && request.auth.uid == resource.data.targetUserId;
      // Only admin can create and delete notifications
      allow create, delete: if isAdmin();
    }

    // FCM Push Tokens - Users register their own, admin reads all for push delivery
    match /fcmTokens/{tokenId} {
      // Users can create/update/delete their own tokens
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      // Admin can read all tokens (needed for sending push notifications)
      allow read: if isAdmin();
    }

    // Colab Rooms - Real-time collaborative listening sessions
    // Read/Update: Any authenticated user (app logic handles host-only vs collab permissions)
    // Create: Authenticated user creating room must be designated host
    // Delete: Host or admin
    match /colab_rooms/{roomId} {
      allow read, update: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostId;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.hostId || isAdmin()
      );
    }
  }
}